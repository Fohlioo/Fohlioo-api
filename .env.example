# Supabase — Project Settings → API Keys in your Supabase dashboard
# URL: https://<project-ref>.supabase.co (project ref is in the dashboard URL)
SUPABASE_URL=https://your-project-ref.supabase.co

# Use the Secret key (sb_secret_...), NOT the publishable key.
# This server needs the secret key to bypass RLS.
SUPABASE_SERVICE_KEY=your-supabase-secret-key-here

# Shared secret the extension sends as x-fohlioo-key on event/shopper routes.
# This is NOT a Supabase key — generate your own: openssl rand -hex 32
# Auth exchange does not use this header.
INGEST_API_KEY=replace-with-a-long-random-secret

# Server — 8080 locally so it does not collide with fohlioo-app on 3000
PORT=8080
